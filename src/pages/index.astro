---
const title = "Kurikomi";
const description =
  "An independent software company in Bukhara, Uzbekistan. Maker of Hoaka OS.";
const canonical = "https://kurikomi.com/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — one system, twelve orbits</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0a0908" />
    <meta name="color-scheme" content="dark" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://kurikomi.com/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://kurikomi.com/og.png" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preload" as="font" type="font/woff2" href="/fonts/fraunces-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-latin.woff2" crossorigin />

    <style is:global>
      @font-face {
        font-family: 'Fraunces';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url('/fonts/fraunces-latin.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Fraunces';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url('/fonts/fraunces-latin-ext.woff2') format('woff2');
        unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
      }
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 400 500;
        font-display: swap;
        src: url('/fonts/inter-latin.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 400 500;
        font-display: swap;
        src: url('/fonts/inter-latin-ext.woff2') format('woff2');
        unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
      }

      :root {
        color-scheme: dark;
        --void: #080706;
        --deep: #12100d;
        --bone: #e9e3d8;
        --ash: #8b8379;
        --dim: #5b554e;
        --brass: #cf9a52;
        --brass-hi: #f2cd91;
        --rule: rgba(233, 227, 216, 0.11);
        --serif: "Fraunces", Georgia, "Times New Roman", serif;
        --sans: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui,
          sans-serif;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      [hidden] {
        display: none !important;
      }

      html {
        -webkit-text-size-adjust: 100%;
        text-size-adjust: 100%;
      }

      body {
        margin: 0;
        background: var(--void);
        color: var(--bone);
        font-family: var(--sans);
        font-size: 1.0625rem;
        line-height: 1.7;
        font-feature-settings: "kern", "liga", "calt";
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        overflow-x: hidden;
      }

      a {
        color: inherit;
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 0.2em;
        text-decoration-color: var(--rule);
        transition: text-decoration-color 0.2s ease, color 0.2s ease;
      }
      a:hover {
        color: var(--brass-hi);
        text-decoration-color: var(--brass);
      }
      a:focus-visible {
        outline: 2px solid var(--brass);
        outline-offset: 3px;
        border-radius: 2px;
      }

      ::selection {
        background: var(--brass);
        color: var(--void);
      }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        margin: -1px;
        padding: 0;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
        border: 0;
      }

      .label {
        font-family: var(--sans);
        font-size: 0.6875rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.16em;
        color: var(--ash);
        margin: 0;
      }

      /* ── Orrery stage ─────────────────────────────────────────── */

      .stage {
        position: relative;
        width: 100%;
        height: 100vh;
        height: 100svh;
        min-height: 28rem;
        overflow: hidden;
        opacity: var(--sf, 1);
        background:
          radial-gradient(
            120% 88% at 50% 46%,
            var(--deep) 0%,
            #0b0a08 46%,
            var(--void) 100%
          );
        border-bottom: 1px solid var(--rule);
      }

      #system {
        position: absolute;
        inset: 0;
        will-change: transform;
      }

      #twinkle {
        position: absolute;
        inset: 0;
        pointer-events: none;
      }
      .tw {
        position: absolute;
        width: 2px;
        height: 2px;
        margin: -1px 0 0 -1px;
        border-radius: 50%;
        background: #fff8ea;
        box-shadow: 0 0 7px 1.5px rgba(255, 238, 205, 0.5);
        opacity: 0.16;
        animation-name: tw;
        animation-timing-function: ease-in-out;
        animation-iteration-count: infinite;
      }
      @keyframes tw {
        0%, 100% { opacity: 0.14; transform: scale(0.7); }
        50% { opacity: 0.95; transform: scale(1.25); }
      }

      #stars,
      #rings {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        display: block;
        pointer-events: none;
      }

      #stars {
        opacity: 0;
        animation: fadeIn 1.6s ease 0.2s forwards;
      }
      #rings {
        opacity: 0;
        animation: fadeIn 1.4s ease 0.45s forwards;
        overflow: visible;
      }

      @keyframes fadeIn {
        to {
          opacity: 1;
        }
      }

      .sun {
        position: absolute;
        z-index: 1000;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        width: 92px;
        height: 92px;
        --glyph-w: 27px;
        --glyph-h: 40px;
        display: grid;
        place-items: center;
        pointer-events: none;
        opacity: 0;
        animation: sunIn 1.1s cubic-bezier(0.2, 0.6, 0.2, 1) 0.15s forwards;
      }

      @keyframes sunIn {
        from {
          opacity: 0;
          transform: translate(-50%, -50%) scale(0.86);
        }
        to {
          opacity: 1;
          transform: translate(-50%, -50%) scale(1);
        }
      }

      .sun > * {
        grid-area: 1 / 1;
      }

      /* Corona in two layers so the falloff is not a single flat gradient. */
      .sun::before,
      .sun::after {
        content: "";
        position: absolute;
        border-radius: 50%;
        pointer-events: none;
      }
      .sun::before {
        inset: -95%;
        background: radial-gradient(
          circle,
          rgba(214, 160, 88, 0.16) 0%,
          rgba(207, 154, 82, 0.07) 34%,
          rgba(207, 154, 82, 0) 70%
        );
        animation: corona 13s ease-in-out infinite;
      }
      .sun::after {
        inset: -34%;
        background: radial-gradient(
          circle,
          rgba(255, 233, 184, 0.28) 0%,
          rgba(226, 173, 96, 0.16) 40%,
          rgba(207, 154, 82, 0) 72%
        );
        animation: corona 9s ease-in-out infinite reverse;
      }

      @keyframes corona {
        0%, 100% { opacity: 0.82; transform: scale(1); }
        50% { opacity: 1; transform: scale(1.05); }
      }

      /* Tight bloom directly behind the glyph so it reads as emitting. */
      .sun-bloom {
        width: calc(var(--glyph-w) * 2.6);
        height: calc(var(--glyph-w) * 2.6);
        border-radius: 50%;
        background: radial-gradient(
          circle,
          rgba(255, 246, 226, 0.5) 0%,
          rgba(255, 220, 160, 0.22) 30%,
          rgba(207, 154, 82, 0) 68%
        );
        pointer-events: none;
      }

      .sun-img,
      .sun-core {
        position: relative;
        width: var(--glyph-w);
        height: var(--glyph-h);
        display: block;
      }

      /* Fallback: recolour the bitmap-ish way if masks are unavailable. */
      .sun-img {
        filter: brightness(0) saturate(100%) invert(80%) sepia(28%)
          saturate(1040%) hue-rotate(340deg) brightness(97%) contrast(92%);
      }
      .sun-core {
        display: none;
      }

      /* Preferred: mask the real mark and fill it with a hot-core gradient,
         so the glyph itself glows rather than sitting on top of a glow. */
      @supports ((-webkit-mask-image: url("/logo.svg")) or (mask-image: url("/logo.svg"))) {
        .sun-img { display: none; }
        .sun-core {
          display: block;
          background: radial-gradient(
            circle at 50% 38%,
            #fffdf5 0%,
            #ffeec4 28%,
            var(--brass-hi) 58%,
            var(--brass) 100%
          );
          -webkit-mask: url("/logo.svg") no-repeat center / contain;
          mask: url("/logo.svg") no-repeat center / contain;
        }
      }

      /* ── Bodies ───────────────────────────────────────────────── */

      #bodies {
        position: absolute;
        inset: 0;
        pointer-events: none;
      }

      .body {
        position: absolute;
        left: 0;
        top: 0;
        width: 0;
        height: 0;
        pointer-events: none;
        will-change: transform;
      }

      .orb {
        position: absolute;
        left: 50%;
        top: 50%;
        border-radius: 50%;
        transform: translate(-50%, -50%);
        pointer-events: auto;
        cursor: default;
        background: var(--orb, #6f665b);
        box-shadow: inset 0 0 0 0.5px rgba(233, 227, 216, 0.14);
        transition:
          transform 0.24s cubic-bezier(0.2, 0.6, 0.2, 1),
          box-shadow 0.24s ease;
      }
      .orb:hover {
        transform: translate(-50%, -50%) scale(1.5);
        box-shadow:
          inset 0 0 0 0.5px rgba(233, 227, 216, 0.45),
          0 0 14px 3px rgba(233, 227, 216, 0.16);
      }
      .body.live .orb:hover {
        transform: translate(-50%, -50%) scale(1.3);
        box-shadow:
          inset 0 0 0 0.5px rgba(242, 205, 145, 0.75),
          0 0 20px 5px rgba(207, 154, 82, 0.5),
          0 0 46px 14px rgba(207, 154, 82, 0.24);
      }

      .night {
        position: absolute;
        inset: 0;
        border-radius: 50%;
        overflow: hidden;
        will-change: transform;
      }
      /* The lit hemisphere faces the sun, so an off-centre radial darkens the
         far limb while a thin arc picks out the near one. Both ride .night,
         which is rotated each frame to point at the centre. */
      .night::after {
        content: "";
        position: absolute;
        inset: -1px;
        border-radius: 50%;
        background: radial-gradient(
          circle at 22% 50%,
          rgba(6, 5, 4, 0) 0%,
          rgba(6, 5, 4, 0.14) 40%,
          rgba(6, 5, 4, 0.74) 74%,
          rgba(6, 5, 4, 0.93) 100%
        );
      }
      .night::before {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: 50%;
        background: radial-gradient(
          circle at 15% 50%,
          rgba(255, 240, 214, 0.55) 0%,
          rgba(255, 240, 214, 0.14) 24%,
          rgba(255, 240, 214, 0) 48%
        );
      }

      .body.live .orb {
        cursor: pointer;
        background: #d9a259;
        box-shadow:
          inset 0 0 0 0.5px rgba(242, 205, 145, 0.55),
          0 0 14px 2px rgba(207, 154, 82, 0.34),
          0 0 34px 8px rgba(207, 154, 82, 0.15);
      }

      .body.live .night::after {
        background: radial-gradient(
          circle at 26% 50%,
          rgba(6, 5, 4, 0) 0%,
          rgba(6, 5, 4, 0.05) 42%,
          rgba(6, 5, 4, 0.42) 80%,
          rgba(6, 5, 4, 0.62) 100%
        );
      }

      .tag {
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(1.35rem, -50%);
        white-space: nowrap;
        font-size: 0.6875rem;
        font-weight: 500;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--brass-hi);
        line-height: 1;
        padding: 0.3rem 0 0.3rem 0.65rem;
        border-left: 1px solid rgba(207, 154, 82, 0.4);
        pointer-events: none;
        text-shadow: 0 0 10px rgba(8, 7, 6, 0.9);
      }

      .body.flip .tag {
        transform: translate(-100%, -50%) translateX(-1.35rem);
        padding: 0.3rem 0.65rem 0.3rem 0;
        border-left: none;
        border-right: 1px solid rgba(207, 154, 82, 0.4);
      }

      .body.live a {
        position: absolute;
        left: 50%;
        top: 50%;
        width: 2.75rem;
        height: 2.75rem;
        -webkit-tap-highlight-color: transparent;
        transform: translate(-50%, -50%);
        border-radius: 50%;
        pointer-events: auto;
        text-decoration: none;
      }
      .body.live a:focus-visible {
        outline: 1px solid var(--brass);
        outline-offset: 4px;
      }

      /* ── Readout plaque ───────────────────────────────────────── */

      .readout {
        position: absolute;
        right: 1.5rem;
        bottom: 5.25rem;
        width: 15.5rem;
        padding-top: 0.75rem;
        border-top: 1px solid var(--rule);
        pointer-events: none;
      }

      .readout-label {
        font-size: 0.6875rem;
        font-weight: 500;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--ash);
        margin: 0 0 0.45rem;
      }

      .readout-link {
        display: inline-block;
        font-size: 1.0625rem;
        line-height: 1.2;
        color: var(--brass-hi);
        text-decoration: none;
        pointer-events: auto;
      }
      .readout-link span {
        display: inline-block;
        transition: transform 0.25s cubic-bezier(0.22, 0.61, 0.36, 1);
      }
      .readout-link:hover span,
      .readout-link:focus-visible span {
        transform: translateX(3px);
      }
      .readout-link:hover {
        color: var(--brass-hi);
      }

      .readout-note {
        margin: 0;
        font-size: 1.0625rem;
        line-height: 1.2;
        color: var(--dim);
      }


      @media (min-width: 900px) {
        .readout { right: 3rem; bottom: 6rem; }
      }

      @media (max-width: 640px) {
        .readout {
          width: auto;
          left: 1.5rem;
          right: 1.5rem;
          bottom: 4.5rem;
        }
        .tag { display: none; }
        .sun { width: 64px; height: 64px; --glyph-w: 19px; --glyph-h: 28px; }
      }

      @media (max-height: 480px) {
        .stage { min-height: 0; }
        .tag { display: none; }
        .readout { bottom: 3.5rem; }
      }

      /* ── Editorial ────────────────────────────────────────────── */

      .page a {
        text-decoration: none;
        background-image:
          linear-gradient(var(--brass-hi), var(--brass-hi)),
          linear-gradient(var(--rule), var(--rule));
        background-size: 0% 1px, 100% 1px;
        background-position: 0 100%, 0 100%;
        background-repeat: no-repeat;
        padding-bottom: 2px;
        transition:
          background-size 0.4s cubic-bezier(0.2, 0.6, 0.2, 1),
          color 0.25s ease;
      }
      .page a:hover {
        background-size: 100% 1px, 100% 1px;
      }

      .readout-link {
        background-image: linear-gradient(var(--brass-hi), var(--brass-hi));
        background-size: 0% 1px;
        background-position: 0 100%;
        background-repeat: no-repeat;
        padding-bottom: 3px;
        transition: background-size 0.4s cubic-bezier(0.2, 0.6, 0.2, 1);
      }
      .readout-link:hover {
        background-size: 100% 1px;
      }

      /* Sections lift in as they arrive. The hidden state is applied by JS so
         it can never strand the copy if the script fails. */
      .js-reveal section,
      .js-reveal footer {
        opacity: 0;
        transform: translateY(16px);
        transition:
          opacity 0.8s cubic-bezier(0.2, 0.6, 0.2, 1),
          transform 0.8s cubic-bezier(0.2, 0.6, 0.2, 1);
      }
      .js-reveal .in {
        opacity: 1;
        transform: none;
      }

      .page {
        max-width: 38rem;
        margin: 0 auto;
        padding: 6rem 1.5rem 6rem;
      }

      @media (min-width: 768px) {
        .page a {
        text-decoration: none;
        background-image:
          linear-gradient(var(--brass-hi), var(--brass-hi)),
          linear-gradient(var(--rule), var(--rule));
        background-size: 0% 1px, 100% 1px;
        background-position: 0 100%, 0 100%;
        background-repeat: no-repeat;
        padding-bottom: 2px;
        transition:
          background-size 0.4s cubic-bezier(0.2, 0.6, 0.2, 1),
          color 0.25s ease;
      }
      .page a:hover {
        background-size: 100% 1px, 100% 1px;
      }

      .readout-link {
        background-image: linear-gradient(var(--brass-hi), var(--brass-hi));
        background-size: 0% 1px;
        background-position: 0 100%;
        background-repeat: no-repeat;
        padding-bottom: 3px;
        transition: background-size 0.4s cubic-bezier(0.2, 0.6, 0.2, 1);
      }
      .readout-link:hover {
        background-size: 100% 1px;
      }

      /* Sections lift in as they arrive. The hidden state is applied by JS so
         it can never strand the copy if the script fails. */
      .js-reveal section,
      .js-reveal footer {
        opacity: 0;
        transform: translateY(16px);
        transition:
          opacity 0.8s cubic-bezier(0.2, 0.6, 0.2, 1),
          transform 0.8s cubic-bezier(0.2, 0.6, 0.2, 1);
      }
      .js-reveal .in {
        opacity: 1;
        transform: none;
      }

      .page {
          padding: 8rem 2rem 8rem;
        }
      }

      section {
        margin-bottom: 5rem;
      }

      section .label {
        margin-bottom: 2rem;
      }

      p {
        margin: 0 0 1.4em;
        text-wrap: pretty;
      }
      p:last-child {
        margin-bottom: 0;
      }

      section p:not(.label) {
        color: #cfc8bc;
      }

      footer {
        border-top: 1px solid var(--rule);
        padding-top: 2rem;
        font-size: 0.9375rem;
        color: var(--ash);
        line-height: 1.75;
      }
      footer p {
        margin: 0;
      }
      footer a {
        color: var(--bone);
      }

      .reveal {
        opacity: 0;
        transform: translateY(8px);
        animation: reveal 0.7s cubic-bezier(0.2, 0.6, 0.2, 1) forwards;
      }
      .r-1 { animation-delay: 0.5s; }
      .r-2 { animation-delay: 0.64s; }

      @keyframes reveal {
        to {
          opacity: 1;
          transform: none;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .js-reveal section,
        .js-reveal footer {
          opacity: 1;
          transform: none;
          transition: none;
        }
        .tw { animation: none; }
        .sun::before,
        .sun::after {
          animation: none;
        }
        .reveal,
        #stars,
        #rings,
        .sun {
          opacity: 1;
          transform: none;
          animation: none;
        }
        .sun {
          transform: translate(-50%, -50%);
        }
        *,
        *::before,
        *::after {
          transition: none !important;
        }
      }
    </style>
  </head>
  <body>
    <h1 class="sr-only">Kurikomi</h1>

    <div class="stage" id="stage">
      <canvas id="stars" aria-hidden="true"></canvas>
      <div id="twinkle" aria-hidden="true"></div>
      <div id="system">
        <svg id="rings" aria-hidden="true"></svg>

        <div class="sun" role="img" aria-label="Kurikomi">
          <span class="sun-bloom" aria-hidden="true"></span>
          <img class="sun-img" src="/logo.svg" width="27" height="40" alt="" aria-hidden="true" />
          <span class="sun-core" aria-hidden="true"></span>
        </div>

        <div id="bodies"></div>
      </div>


      <div class="readout reveal r-1" id="readout" data-live="true">
        <p class="readout-label" id="ro-label">Hoaka OS</p>
        <a class="readout-link" id="ro-link" href="https://hoakaos.com"
          >hoakaos.com <span aria-hidden="true">&rarr;</span></a
        >
        <p class="readout-note" id="ro-note" hidden>Unassigned</p>
      </div>
    </div>

    <main class="page">
      <section>
        <p>
          <a href="https://hoakaos.com">Hoaka OS</a> is an operating system for
          university computer labs. Every machine boots from the same clean
          system, opens only what the university allows, locks to a single page
          for exams, and wipes itself when the student logs out.
        </p>
      </section>


      <section aria-labelledby="company">
        <p id="company" class="label">The company</p>
        <p>
          Kurikomi, Inc. was founded in 2026 and is headquartered in Bukhara,
          Uzbekistan.
        </p>
      </section>

      <footer>
        <p>
          <a href="https://github.com/kurikomi-labs">GitHub</a>
          &middot;
          <a href="mailto:hello@kurikomi.com">hello@kurikomi.com</a>
        </p>
        <p>&copy; 2026</p>
      </footer>
    </main>

    <script>
      (() => {
        const stage = document.getElementById("stage");
        const starsCanvas = document.getElementById("stars");
        const ringsSvg = document.getElementById("rings");
        const bodiesLayer = document.getElementById("bodies");
        const twinkleEl = document.getElementById("twinkle");
        const systemEl = document.getElementById("system");
        const sunEl = document.querySelector(".sun");
        const readout = document.getElementById("readout");
        const roLabel = document.getElementById("ro-label");
        const roLink = document.getElementById("ro-link");
        const roNote = document.getElementById("ro-note");
        if (!stage || !bodiesLayer || !ringsSvg || !starsCanvas) return;

        const SVG_NS = "http://www.w3.org/2000/svg";
        const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        // Viewing angle measured from the pole. Narrow screens get a
        // shallower angle so the inner orbits keep vertical separation.
        let TAGS_ON = true;
        let SQUASH = Math.cos((70 * Math.PI) / 180);
        let DEPTH = Math.sin((70 * Math.PI) / 180);
        // One second of wall clock is 1/26 of the innermost body's year.
        const YEARS_PER_SEC = 1 / 26;
        const ROMAN = ["I","II","III","IV","V","VI","VII","VIII","IX","X","XI","XII"];

        // a — semi-major axis in arbitrary units; period follows Kepler's third
        // law (T = a^1.5) rather than being authored, so the inner bodies
        // genuinely outrun the outer ones. e/omega/M0 fix the ellipse.
        const BODIES = [
          { a: 1.00, e: 0.062, omega: 0.42, m0: 1.9, size: 5.0, tint: "#6f665b" },
          { a: 1.46, e: 0.031, omega: 2.61, m0: 4.4, size: 6.4, tint: "#7b7165" },
          { a: 1.96, e: 0.094, omega: 5.02, m0: 0.6, size: 5.6, tint: "#655d53" },
          { a: 2.50, e: 0.048, omega: 1.18, m0: 3.2, size: 7.2, tint: "#847a6d" },
          { a: 3.08, e: 0.115, omega: 3.77, m0: 5.6, size: 4.6, tint: "#5e574e" },
          { a: 3.70, e: 0.029, omega: 0.88, m0: 2.3, size: 11.5, live: true,
            name: "Hoaka OS", href: "https://hoakaos.com", state: "Shipping" },
          { a: 4.36, e: 0.071, omega: 4.33, m0: 5.1, size: 6.0, tint: "#726a5f" },
          { a: 5.06, e: 0.038, omega: 2.05, m0: 0.9, size: 8.2, tint: "#8a8072" },
          { a: 5.80, e: 0.102, omega: 5.61, m0: 3.9, size: 5.2, tint: "#615a51" },
          { a: 6.58, e: 0.055, omega: 1.54, m0: 2.7, size: 6.8, tint: "#776d62" },
          { a: 7.40, e: 0.084, omega: 3.19, m0: 5.9, size: 4.8, tint: "#5a544b" },
          { a: 8.26, e: 0.042, omega: 0.27, m0: 1.3, size: 7.6, tint: "#807668" },
        ];

        const A_MAX = BODIES[BODIES.length - 1].a;

        // Real systems are not coplanar. Inclination (deg) tilts each orbit
        // against the reference plane; the ascending node turns the tilt axis.
        const INC = [6.8, 2.1, 9.4, 4.3, 11.8, 2.6, 7.9, 13.2, 5.1, 10.4, 3.4, 8.7];
        const NODE = [0.4, 2.9, 5.1, 1.3, 3.8, 0.9, 4.6, 2.2, 5.7, 1.8, 3.1, 0.2];

        BODIES.forEach((b, i) => {
          b.period = Math.pow(b.a, 1.5);
          b.lum = Math.max(0.5, Math.pow(1 / b.a, 0.4));
          b.inc = (INC[i] * Math.PI) / 180;
          b.ci = Math.cos(b.inc);
          b.si = Math.sin(b.inc);
          b.cO = Math.cos(NODE[i]);
          b.sO = Math.sin(NODE[i]);
        });

        const P = { x: 0, y: 0, depth: 0 };

        // A stroke cannot fade along a curved path, so the trail is a run of
        // short segments with a falling opacity ramp. Spans 0.45rad of
        // eccentric anomaly behind the live body.
        const TRAIL_SEGS = 16;
        const TRAIL_SPAN = 0.6;
        const trailSegs = [];

        // Orbital elements to screen. Shared by the rings and the bodies, so a
        // planet can never drift off the ellipse it is supposed to ride.
        function project(b, nu, r, out) {
          const u = nu + b.omega;
          const cu = Math.cos(u);
          const su = Math.sin(u);
          const X = r * (b.cO * cu - b.sO * su * b.ci);
          const Y = r * (b.sO * cu + b.cO * su * b.ci);
          const Z = r * su * b.si;
          out.x = cx + X;
          out.y = cy + Y * SQUASH - Z * DEPTH;
          out.depth = Y * DEPTH + Z * SQUASH;
          return out;
        }

        function trueAnomaly(b, E) {
          return (
            2 *
            Math.atan2(
              Math.sqrt(1 + b.e) * Math.sin(E / 2),
              Math.sqrt(1 - b.e) * Math.cos(E / 2)
            )
          );
        }

        // ── DOM ────────────────────────────────────────────────────
        BODIES.forEach((b, i) => {
          const el = document.createElement("div");
          el.className = "body" + (b.live ? " live" : "");

          const orb = document.createElement("span");
          orb.className = "orb";
          orb.style.width = b.size + "px";
          orb.style.height = b.size + "px";
          if (b.tint) orb.style.setProperty("--orb", b.tint);
          // The live body is exempt: it is the one thing the page is pointing
          // at, and dimming it by distance would bury the lede.
          if (!b.live) orb.style.filter = "brightness(" + b.lum.toFixed(3) + ")";

          const night = document.createElement("span");
          night.className = "night";
          orb.appendChild(night);
          el.appendChild(orb);

          if (b.live) {
            const link = document.createElement("a");
            link.href = b.href;
            link.setAttribute("tabindex", "-1");
            link.setAttribute("aria-hidden", "true");
            el.appendChild(link);

            const tag = document.createElement("span");
            tag.className = "tag";
            tag.textContent = b.name;
            el.appendChild(tag);
            b.tag = tag;
          } else {
            el.setAttribute("aria-hidden", "true");
          }

          const enter = () => show(i);
          orb.addEventListener("mouseenter", enter);
          orb.addEventListener("mouseleave", () => show(5));
          if (b.live) {
            el.querySelector("a").addEventListener("focus", enter);
            el.querySelector("a").addEventListener("blur", () => show(5));
          }

          b.el = el;
          b.night = night;
          bodiesLayer.appendChild(el);
        });

        function show(i) {
          const b = BODIES[i];
          readout.dataset.live = b.live ? "true" : "false";
          roLabel.textContent = b.live ? b.name : "Orbit " + ROMAN[i];
          roLink.hidden = !b.live;
          roNote.hidden = !!b.live;
        }

        // ── Layout ─────────────────────────────────────────────────
        let cx = 0, cy = 0, unit = 0, W = 0, H = 0;

        function layout() {
          const rect = stage.getBoundingClientRect();
          W = rect.width;
          H = rect.height;
          cx = W / 2;
          cy = H * (W < 640 ? 0.55 : 0.5);

          TAGS_ON = W >= 640 && H >= 480;
          const view = ((W < 640 ? 57 : 70) * Math.PI) / 180;
          SQUASH = Math.cos(view);
          DEPTH = Math.sin(view);

          const maxRadius = Math.min(
            W * (W < 640 ? 0.47 : 0.45),
            H * 0.46 / SQUASH,
            760
          );
          unit = maxRadius / A_MAX;

          if (sunEl) {
            sunEl.style.left = cx + "px";
            sunEl.style.top = cy + "px";
          }

          BODIES.forEach((b) => { b.tagW = 0; });
          drawStars();
          drawTwinkle();
          drawRings();
          // Place immediately so bodies are correct even while paused.
          place(elapsed * YEARS_PER_SEC);
        }

        function drawStars() {
          const dpr = Math.min(window.devicePixelRatio || 1, 2);
          starsCanvas.width = W * dpr;
          starsCanvas.height = H * dpr;
          const ctx = starsCanvas.getContext("2d");
          if (!ctx) return;
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          ctx.clearRect(0, 0, W, H);

          // Dust lying in the orbital plane — the same squash the orbits use,
          // so the system sits in a disc rather than empty black.
          const bandR = A_MAX * unit * 1.15;
          if (bandR > 0) {
            ctx.save();
            ctx.translate(cx, cy);
            ctx.scale(1, SQUASH);
            const band = ctx.createRadialGradient(0, 0, 0, 0, 0, bandR);
            band.addColorStop(0, "rgba(212, 162, 95, 0.11)");
            band.addColorStop(0.4, "rgba(180, 138, 84, 0.05)");
            band.addColorStop(1, "rgba(150, 118, 74, 0)");
            ctx.fillStyle = band;
            ctx.beginPath();
            ctx.arc(0, 0, bandR, 0, 6.2831853);
            ctx.fill();
            ctx.restore();
          }

          // Deterministic scatter — the field must not reshuffle on resize.
          let seed = 0x9e3779b9;
          const rand = () => {
            seed ^= seed << 13; seed ^= seed >>> 17; seed ^= seed << 5;
            return ((seed >>> 0) % 100000) / 100000;
          };

          const count = Math.round((W * H) / 4200);
          for (let i = 0; i < count; i++) {
            const x = rand() * W;
            const y = rand() * H;
            const r = rand();
            // Thin the field near the sun so the orrery reads clean.
            const d = Math.hypot(x - cx, (y - cy) / SQUASH) / (A_MAX * unit || 1);
            const near = Math.min(1, 0.18 + d * 0.75);

            if (r > 0.988) {
              // A handful of bright stars get a soft halo rather than a flat
              // dot, which is what keeps the field from looking like noise.
              const rad = 3.2 + rand() * 2.4;
              const a = (0.5 + rand() * 0.35) * near;
              const g = ctx.createRadialGradient(x, y, 0, x, y, rad);
              g.addColorStop(0, "rgba(255, 248, 232, " + a + ")");
              g.addColorStop(0.35, "rgba(255, 236, 203, " + a * 0.28 + ")");
              g.addColorStop(1, "rgba(255, 230, 190, 0)");
              ctx.fillStyle = g;
              ctx.beginPath();
              ctx.arc(x, y, rad, 0, 6.2831853);
              ctx.fill();
              ctx.fillStyle = "rgba(255, 252, 245, " + Math.min(1, a * 1.3) + ")";
              ctx.beginPath();
              ctx.arc(x, y, 0.85, 0, 6.2831853);
              ctx.fill();
            } else {
              const size = r > 0.93 ? 1.15 : r > 0.78 ? 0.85 : 0.6;
              const a = (0.08 + rand() * 0.42) * near;
              ctx.fillStyle =
                r > 0.88
                  ? "rgba(240, 226, 202, " + a + ")"
                  : "rgba(222, 226, 235, " + a + ")";
              ctx.beginPath();
              ctx.arc(x, y, size, 0, 6.2831853);
              ctx.fill();
            }
          }
        }

        function drawTwinkle() {
          twinkleEl.textContent = "";
          if (reduced) return;
          let seed = 0x1b873593;
          const rnd = () => {
            seed ^= seed << 13; seed ^= seed >>> 17; seed ^= seed << 5;
            return ((seed >>> 0) % 100000) / 100000;
          };
          const pts = [];
          // Capped loop: the clearance test can fail on small viewports and
          // must not spin.
          for (let k = 0; k < 300 && pts.length < 7; k++) {
            const x = rnd() * W;
            const y = rnd() * H;
            const d = Math.hypot(x - cx, (y - cy) / SQUASH) / (A_MAX * unit || 1);
            if (d > 1.25) pts.push([x, y, rnd()]);
          }
          const frag = document.createDocumentFragment();
          for (const [x, y, v] of pts) {
            const el = document.createElement("span");
            el.className = "tw";
            el.style.left = x.toFixed(0) + "px";
            el.style.top = y.toFixed(0) + "px";
            el.style.animationDuration = (4.5 + v * 5).toFixed(1) + "s";
            el.style.animationDelay = (-v * 7).toFixed(1) + "s";
            frag.appendChild(el);
          }
          twinkleEl.appendChild(frag);
        }

        function drawRings() {
          ringsSvg.textContent = "";
          ringsSvg.setAttribute("viewBox", "0 0 " + W + " " + H);
          const frag = document.createDocumentFragment();
          const STEPS = 320;

          BODIES.forEach((b) => {
            let d = "";
            for (let k = 0; k <= STEPS; k++) {
              const E = (k / STEPS) * 6.2831853;
              const r = b.a * (1 - b.e * Math.cos(E)) * unit;
              project(b, trueAnomaly(b, E), r, P);
              d += (k ? "L" : "M") + P.x.toFixed(2) + " " + P.y.toFixed(2);
            }
            const el = document.createElementNS(SVG_NS, "path");
            el.setAttribute("d", d + "Z");
            el.setAttribute("fill", "none");
            el.setAttribute("stroke-width", "1");
            if (b.live) {
              el.setAttribute("stroke", "rgba(207, 154, 82, 0.55)");
            } else {
              const a = (0.2 * (0.55 + 0.45 * b.lum)).toFixed(3);
              el.setAttribute("stroke", "rgba(233, 227, 216, " + a + ")");
              el.setAttribute("stroke-dasharray", "2 6");
            }
            frag.appendChild(el);
          });

          trailSegs.length = 0;
          const live = BODIES.find((b) => b.live);
          // A trail implies motion, so it has no business in a still scene.
          if (live && !reduced) {
            for (let k = 0; k < TRAIL_SEGS; k++) {
              const t = 1 - k / TRAIL_SEGS;
              const seg = document.createElementNS(SVG_NS, "path");
              seg.setAttribute("fill", "none");
              seg.setAttribute("stroke-linecap", "round");
              seg.setAttribute("stroke", "rgba(255, 234, 196, " + (0.95 * t * t).toFixed(3) + ")");
              seg.setAttribute("stroke-width", (2.6 * t + 0.4).toFixed(2));
              frag.appendChild(seg);
              trailSegs.push(seg);
            }
          }

          ringsSvg.appendChild(frag);
        }

        // ── Motion ─────────────────────────────────────────────────
        function place(t) {
          for (let i = 0; i < BODIES.length; i++) {
            const b = BODIES[i];
            const M = b.m0 + (2 * Math.PI * t) / b.period;

            // Newton on Kepler's equation M = E - e·sin E. Four passes is
            // plenty at these eccentricities.
            let E = M;
            for (let k = 0; k < 4; k++) {
              E -= (E - b.e * Math.sin(E) - M) / (1 - b.e * Math.cos(E));
            }

            const nu = trueAnomaly(b, E);
            const r = b.a * (1 - b.e * Math.cos(E)) * unit;

            project(b, nu, r, P);
            const sx = P.x;
            const sy = P.y;
            const depth = P.depth;

            const scale = 1 + (depth / (A_MAX * unit || 1)) * 0.16;
            b.el.style.transform =
              "translate3d(" + sx + "px," + sy + "px,0) scale(" + scale + ")";
            const layer = 1000 + Math.round(depth);
            if (b.layer !== layer) {
              b.layer = layer;
              b.el.style.zIndex = String(layer);
            }

            // Terminator faces away from the sun, which is always at centre.
            b.night.style.transform = "rotate(" + Math.atan2(sy - cy, sx - cx) + "rad)";

            if (b.live && trailSegs.length) {
              let px = sx;
              let py = sy;
              for (let k = 0; k < TRAIL_SEGS; k++) {
                const e = E - (TRAIL_SPAN * (k + 1)) / TRAIL_SEGS;
                const rr = b.a * (1 - b.e * Math.cos(e)) * unit;
                project(b, trueAnomaly(b, e), rr, P);
                trailSegs[k].setAttribute(
                  "d",
                  "M" + px.toFixed(1) + " " + py.toFixed(1) +
                  "L" + P.x.toFixed(1) + " " + P.y.toFixed(1)
                );
                px = P.x;
                py = P.y;
              }
            }

            if (b.live && TAGS_ON) {
              // Sit the label on the leading side. The trail sweeps out behind
              // the body, so anchoring to the direction of travel keeps the two
              // from ever sharing the same space.
              const ahead = E + 0.05;
              const ra = b.a * (1 - b.e * Math.cos(ahead)) * unit;
              project(b, trueAnomaly(b, ahead), ra, P);

              const need = b.tagW || (b.tagW = b.tag.offsetWidth + 26);
              let flip = P.x < sx;
              if (flip && sx - need < 6) flip = false;
              else if (!flip && sx + need > W - 6) flip = true;
              if (b.flipped !== flip) {
                b.flipped = flip;
                b.el.classList.toggle("flip", flip);
              }
            }
          }
        }

        // Pointer parallax. Targets are set on move and eased toward in the
        // frame loop so the tilt never snaps.
        const TILT_MAX = 3.4;
        const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
        let tiltX = 0, tiltY = 0, tiltTX = 0, tiltTY = 0;

        if (finePointer && !reduced) {
          stage.addEventListener("pointermove", (e) => {
            const r = stage.getBoundingClientRect();
            tiltTY = ((e.clientX - r.left) / r.width - 0.5) * 2 * TILT_MAX;
            tiltTX = -((e.clientY - r.top) / r.height - 0.5) * 2 * TILT_MAX;
          });
          stage.addEventListener("pointerleave", () => {
            tiltTX = 0;
            tiltTY = 0;
          });
        }

        let scrollP = 0;
        let lastDrift = -1;
        const onScroll = () => {
          const h = stage.offsetHeight || 1;
          scrollP = Math.min(1, Math.max(0, window.scrollY / h));
          stage.style.setProperty("--sf", (1 - scrollP * 0.92).toFixed(3));
        };
        window.addEventListener("scroll", onScroll, { passive: true });
        onScroll();

        const page = document.querySelector(".page");
        if (page && "IntersectionObserver" in window) {
          page.classList.add("js-reveal");
          const io = new IntersectionObserver(
            (entries) => {
              for (const e of entries) {
                if (e.isIntersecting) {
                  e.target.classList.add("in");
                  io.unobserve(e.target);
                }
              }
            },
            { rootMargin: "0px 0px -12% 0px" }
          );
          page.querySelectorAll("section, footer").forEach((el) => io.observe(el));
        }

        let elapsed = 0;
        let last = 0;

        function frame(now) {
          // rAF already stops while the tab is hidden; the clamp keeps a long
          // gap from fast-forwarding the system by years on the next frame.
          if (last) elapsed += Math.min((now - last) / 1000, 0.1);
          last = now;
          place(elapsed * YEARS_PER_SEC);

          const dx = tiltTX - tiltX;
          const dy = tiltTY - tiltY;
          const drift = -(scrollP * 70);
          if (Math.abs(dx) > 0.001 || Math.abs(dy) > 0.001 || drift !== lastDrift) {
            tiltX += dx * 0.06;
            tiltY += dy * 0.06;
            lastDrift = drift;
            systemEl.style.transform =
              "perspective(1400px) translateY(" + drift.toFixed(1) +
              "px) rotateX(" + tiltX.toFixed(3) +
              "deg) rotateY(" + tiltY.toFixed(3) + "deg)";
          }

          requestAnimationFrame(frame);
        }

        let resizeTimer = 0;
        window.addEventListener("resize", () => {
          clearTimeout(resizeTimer);
          resizeTimer = window.setTimeout(layout, 120);
        });

        layout();
        show(5);

        if (!reduced) requestAnimationFrame(frame);
      })();
    </script>
  </body>
</html>
